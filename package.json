{
  "name": "vemtas",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @vemtas/testing test:integration",
    "migration-from-zero": "pnpm --filter @vemtas/db migration-from-zero"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.5.6",
    "typescript": "5.9.2"
  }
}
